		<ProjectReference Include="..\..\Unity\Assets\Plugins\StaticEcs\StaticEcs.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" Version="2.0.9"/>
	</ItemGroup>

</Project>
